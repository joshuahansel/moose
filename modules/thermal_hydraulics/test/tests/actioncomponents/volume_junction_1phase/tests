[Tests]
  issues = '#19830 #32558'
  design = 'VolumeJunction1PhaseAC.md'

  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 7e-8
    difference_tol = 60
    cli_args = 'Debug/check_jacobian=true'
    max_threads = 1
    max_parallel = 1
    requirement = 'The system shall have correct Jacobians for the user object, boundary '
                  'conditions, and kernels that a VolumeJunction1Phase native ActionComponent '
                  'creates and attaches to itself to couple two single-phase flow channels through '
                  'a non-zero-volume junction.'
  []
  [transient]
    type = CSVDiff
    input = 'transient.i'
    csvdiff = 'transient_out.csv'
    requirement = 'The system shall be able to solve a transient, single-phase flow problem '
                  'through two flow channels connected by a VolumeJunction1Phase ActionComponent, '
                  'with a prescribed mass flow rate and temperature inlet and a prescribed pressure '
                  'outlet, all defined as native ActionComponents, with the junction having its own '
                  'mesh, variables, and kernels.'
  []
  [equal_area_x_direction]
    type = 'CSVDiff'
    input = 'equal_area_with_junction.i'
    cli_args = "ActionComponents/junction/volume=1.0"
    csvdiff = 'equal_area_with_junction_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a flow junction ActionComponent connecting 2 pipes of equal area in the x direction.'
  []
  [equal_area_not_x_direction]
    type = 'CSVDiff'
    input = 'equal_area_with_junction.i'
    cli_args = "ActionComponents/junction/volume=1.0 Functions/T0/axis=y ActionComponents/pipe1/orientation='0 1 0' ActionComponents/junction/position='0 1.02 0' ActionComponents/junction/initial_vel_x=0 ActionComponents/junction/initial_vel_y=1 ActionComponents/pipe2/position='0 1.04 0' ActionComponents/pipe2/orientation='0 1 0' Postprocessors/junction_rhou/variable=rhovV"
    csvdiff = 'equal_area_with_junction_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a flow junction ActionComponent connecting 2 pipes of equal area not in the x direction.'
  []
  [phy:unequal_area]
    type = 'CSVDiff'
    input = 'phy.unequal_area.i'
    csvdiff = 'phy.unequal_area_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    abs_zero = 5e-5
    rel_err = 0
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a flow junction ActionComponent connecting 2 pipes of different area.'
  []
  [phy:deadend]
    type = 'CSVDiff'
    input = 'phy.deadend.i'
    csvdiff = 'phy.deadend_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    abs_zero = 1e-5
    rel_err = 0
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a flow junction ActionComponent with a dead end.'
  []
  [phy:shower_syntax]
    type = 'RunApp'
    input = 'phy.shower.i'
    check_input = true
    requirement = 'The system shall be able to check the syntax for 2 pipes with different temperatures mixing together into a third pipe through a flow junction ActionComponent.'
  []
  [phy:shower]
    type = 'CSVDiff'
    input = 'phy.shower.i'
    csvdiff = 'phy.shower_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    abs_zero = 2e-9
    rel_err = 0
    heavy = true
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model 2 pipes with different temperatures mixing together into a third pipe through a flow junction ActionComponent.'
  []
  [calorically_imperfect_gas]
    type = 'CSVDiff'
    input = 'junction_with_calorifically_imperfect_gas.i'
    csvdiff = 'junction_with_calorifically_imperfect_gas_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    abs_zero = 5e-5
    rel_err = 1e-4
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a flow junction ActionComponent with a calorically imperfect gas.'
  []
  [phy.form_loss]
    type = 'CSVDiff'
    input = 'phy.form_loss.i'
    cli_args = "ActionComponents/junction/K=1 Outputs/file_base=phy.form_loss"
    csvdiff = 'phy.form_loss.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    rel_err = 2e-4
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a form loss in a flow junction ActionComponent.'
  []
  [phy.form_loss_Aref]
    type = 'CSVDiff'
    input = 'phy.form_loss.i'
    cli_args = "ActionComponents/junction/K=1 ActionComponents/junction/A_ref=0.2 Outputs/file_base=phy.form_loss_Aref"
    csvdiff = 'phy.form_loss_Aref.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    rel_err = 2e-4
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a form loss in a flow junction ActionComponent with a reference area.'
  []
  [phy.form_loss_crtl]
    type = 'CSVDiff'
    input = 'phy.form_loss.i'
    cli_args = "ActionComponents/junction/K=1 ChainControls/active='K_crtl_fn K_crtl' Outputs/execute_on=TIMESTEP_END Outputs/file_base=phy.form_loss_crtl"
    csvdiff = 'phy.form_loss_crtl.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    rel_err = 2e-4
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a form loss in a flow junction ActionComponent with the loss coefficient specified through the control system.'
  []
  [conservation_1phase]
    type = 'CSVDiff'
    input = 't_junction_1phase.i'
    csvdiff = 't_junction_1phase_out.csv'
    gold_dir = '../../components/volume_junction_1phase/gold'
    abs_zero = 1e-10
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall conserve mass and energy through a flow junction ActionComponent connecting 3 pipes.'
  []
  [err.missing_ics]
    type = 'RunException'
    input = 'err.missing_ics.i'
    expect_err = "ActionComponents/junction/initial_p: The following initial condition parameters are missing: initial_p initial_T initial_vel_x initial_vel_y initial_vel_z"
    requirement = 'The system shall throw an error if initial conditions for the VolumeJunction1Phase ActionComponent are missing.'
  []
  [err.missing_K]
    type = 'RunException'
    input = 'phy.form_loss.i'
    cli_args = '--error ActionComponents/junction/A_ref=1'
    expect_err = "Parameter 'A_ref' is specified, but 'K' is not specified, so the junction will behave as if there were no form loss."
    requirement = 'The system shall throw an error if the parameter "A_ref" is specifed and the paramter "K" is not specified for a VolumeJunction1Phase ActionComponent.'
  []
[]
