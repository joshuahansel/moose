[Tests]
  issues = '#19830 #32558'
  design = 'HSBoundaryRadiationAC.md'

  [energy_conservation]
    requirement = 'The system shall be able to simulate radiative heat transfer on the boundary of '
                  'a heat structure ActionComponent and show conservation of energy'

    [cylindrical]
      type = CSVDiff
      input = 'cylindrical.i'
      csvdiff = 'cylindrical_out.csv'
      gold_dir = '../../components/hs_boundary_radiation/gold'
      abs_zero = 1e-6
      restep = false # Test is prescribed to abort on failed timestep
      detail = 'for a cylindrical heat structure, with a heat rate post-processor consistent with '
               'the applied heat flux, and'
    []
    [plate]
      type = CSVDiff
      input = 'plate.i'
      csvdiff = 'plate_out.csv'
      gold_dir = '../../components/hs_boundary_radiation/gold'
      abs_zero = 1e-6
      restep = false # Test is prescribed to abort on failed timestep
      detail = 'for a plate heat structure.'
    []
  []

  [energy_conservation_from_file_3d]
    type = 'CSVDiff'
    input = 'from_file_3d.i'
    csvdiff = 'from_file_3d_out.csv'
    gold_dir = '../../components/hs_boundary_radiation/gold'
    abs_zero = 1e-6
    # because output has execute_on = 'final'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to apply a radiative boundary condition on the boundary of a heat structure ActionComponent created from a 3D mesh file and show conservation of energy.'
  []
[]
