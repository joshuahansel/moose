[Tests]
  issues = '#19830 #32558'
  design = 'HeatTransferFromExternalAppHeatFlux1PhaseAC.md HeatTransferFromExternalAppTemperature1PhaseAC.md'

  [phy:q_wall_transfer_3eqn]
    type = Exodiff
    input = 'phy.q_wall_transfer_3eqn.parent.i'
    exodiff = 'phy.q_wall_transfer_3eqn.parent_out.e phy.q_wall_transfer_3eqn.parent_out_thm0.e'
    # The parent is included from the classic directory, so its sub-app input is the classic one
    # unless it is overridden
    cli_args = 'MultiApps/thm/input_files=../../actioncomponents/heat_transfer_from_external_app_1phase/phy.q_wall_transfer_3eqn.child.i'
    gold_dir = '../../components/heat_transfer_from_external_app_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to solve for single phase heat transfer in a flow channel ActionComponent with the wall heat flux provided by an external application.'
  []
  [phy:T_wall_transfer_3eqn]
    type = Exodiff
    input = 'phy.T_wall_transfer_3eqn.parent.i'
    exodiff = 'phy.T_wall_transfer_3eqn.parent_out.e phy.T_wall_transfer_3eqn.parent_out_thm0_out.e'
    gold_dir = '../../components/heat_transfer_from_external_app_1phase/gold'
    cli_args = 'MultiApps/thm/input_files=../../actioncomponents/heat_transfer_from_external_app_1phase/phy.T_wall_transfer_3eqn.child.i thm:ActionComponents/hxconn/initial_T_wall=300'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to solve for single phase heat transfer in a flow channel ActionComponent with the wall temperature provided by an external application.'
  []
  [phy:T_wall_transfer_elem_3eqn]
    type = Exodiff
    input = 'phy.T_wall_transfer_elem_3eqn.parent.i'
    exodiff = 'phy.T_wall_transfer_elem_3eqn.parent_out.e phy.T_wall_transfer_elem_3eqn.parent_out_thm0_out.e'
    cli_args = 'MultiApps/thm/input_files=../../actioncomponents/heat_transfer_from_external_app_1phase/phy.T_wall_transfer_elem_3eqn.child.i'
    gold_dir = '../../components/heat_transfer_from_external_app_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to solve for single phase heat transfer in a flow channel ActionComponent with the elemental wall temperature provided by an external application.'
  []
  [phy:T_wall_transfer_ext_3eqn]
    type = Exodiff
    input = 'phy.T_wall_transfer_3eqn.parent.i'
    exodiff = 'phy.T_wall_transfer_ext_3eqn.e phy.T_wall_transfer_ext_3eqn_thm0_out.e'
    gold_dir = '../../components/heat_transfer_from_external_app_1phase/gold'
    cli_args = "MultiApps/thm/input_files=../../actioncomponents/heat_transfer_from_external_app_1phase/phy.T_wall_transfer_3eqn.child.i "
               "Outputs/file_base=phy.T_wall_transfer_ext_3eqn Transfers/T_to_child/variable=T_ext "
               "thm:AuxVariables/T_ext/initial_condition=300 "
               "thm:ActionComponents/hxconn/T_ext=T_ext thm:Outputs/out/show='T_ext'"
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to solve for single phase heat transfer in a flow channel ActionComponent with the exterior temperature, given by a variable of an external application, provided by an external application.'
  []
[]
