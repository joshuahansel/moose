[Tests]
  issues = '#19830 #32558'
  design = 'SimpleTurbine1PhaseAC.md'

  [phy:conservation]
    type = 'CSVDiff'
    input = 'phy.conservation.i'
    csvdiff = 'phy.conservation_csv.csv'
    gold_dir = '../../components/simple_turbine_1phase/gold'
    override_columns = 'energy_diff mass_diff momentum_diff'
    override_abs_zero = '5e-6 2e-7 1e-4'
    override_rel_err = '0 0 0'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a simple turbine ActionComponent in 1D single phase compressible flow and show mass and energy conservation.'
  []
  [phy:test]
    type = 'Exodiff'
    input = 'phy.test.i'
    exodiff = 'phy.test_out.e'
    gold_dir = '../../components/simple_turbine_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to model a simple turbine ActionComponent in 1D single phase compressible flow.'
  []
  [clg:test]
    type = 'CSVDiff'
    input = 'clg.test.i'
    csvdiff = 'clg.test_csv.csv'
    gold_dir = '../../components/simple_turbine_1phase/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to control the power of a simple turbine ActionComponent.'
  []
  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 1e-7
    difference_tol = 170
    cli_args = 'Debug/check_jacobian=true'
    allow_test_objects = true
    max_threads = 1
    max_parallel = 1
    requirement = 'The system shall have correct Jacobians for a simple turbine ActionComponent.'
  []
[]
