[Tests]
  issues = '#19830 #32558'
  design = 'HeatSourceFromPowerDensityAC.md'

  [phy:power_density_shape]
    type = 'Exodiff'
    input = 'phy.cylinder_power_shape_aux_var.i'
    exodiff = 'phy.cylinder_power_shape_aux_var_out.e'
    gold_dir = '../../components/heat_source_from_power_density/gold'
    rel_err = 1e-4
    abs_zero = 1e-9
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall provide the heat source shape for a heat structure ActionComponent when power density is supplied, using the same input and reference results as the classic component.'
  []

  [err:no_hs]
    type = 'RunException'
    input = 'err.base.i'
    cli_args = "ActionComponents/hgen/hs=hgen ActionComponents/hgen/regions='fuel'"
    expect_err = "ActionComponents/hgen/hs: The component 'hgen' is not of type 'HeatStructureInterface'"
    requirement = 'The system shall report an error if the heat structure specified to apply a heat source on is not of the adequate type for an ActionComponent.'
  []
  [err:wrong_block_name]
    type = 'RunException'
    input = 'err.base.i'
    cli_args = "ActionComponents/hgen/hs=hs ActionComponents/hgen/regions='asdf'"
    expect_err = "ActionComponents/hgen/regions: Region 'asdf' does not exist in heat structure 'hs'."
    requirement = 'The system shall report an error if the specified region to apply a heat source on does not exist for an ActionComponent.'
  []

  [phy:conservation_from_file_3d]
    type = 'CSVDiff'
    input = 'phy.conservation_from_file_3d.i'
    csvdiff = 'phy.conservation_from_file_3d_out.csv'
    gold_dir = '../../components/heat_source_from_power_density/gold'
    rel_err = 1e-4
    abs_zero = 1e-9
    # because output has execute_on = 'final'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to apply a heat source, computed from a power density, onto a heat structure ActionComponent whose mesh is loaded from a mesh file.'
  []
[]
