[Tests]
  issues = '#19830 #32558 #33877'
  design = 'FlowChannel1PhaseAC.md'

  [mesh]
    type = Exodiff
    input = 'mesh.i'
    exodiff = 'mesh_in.e'
    cli_args = '--mesh-only mesh_in.e'
    requirement = 'The system shall be able to generate the mesh of a 1D single-phase flow '
                  'channel as a native ActionComponent, using the MeshGenerator system rather '
                  'than the hand-built mesh of the classic FlowChannel1Phase Component, with the '
                  'inlet/outlet boundaries renamed to match the classic naming convention.'
    # mesh generation test
    recover = false
  []
  [jacobian_no_closures]
    type = 'PetscJacobianTester'
    input = 'jacobian_no_closures.i'
    ratio_tol = 7e-8
    difference_tol = 15
    cli_args = 'Debug/check_jacobian=true'
    max_threads = 1
    max_parallel = 1
    requirement = 'The system shall have correct Jacobians for the mass, momentum, and energy '
                  'kernels of the single-phase flow channel physics that a native ActionComponent '
                  'creates and attaches to itself, excluding wall friction and wall heat transfer.'
  []
  [steady_no_closures]
    type = Exodiff
    input = 'steady_no_closures.i'
    exodiff = 'steady_no_closures_out.e'
    requirement = 'The system shall be able to solve a steady-state, single-phase flow channel '
                  'problem with a prescribed mass flow rate and temperature inlet and a '
                  'prescribed pressure outlet, all defined as native ActionComponents connected '
                  'by boundary name, regardless of their declaration order in the input file.'
  []
  [experimental_notice]
    type = RunApp
    input = 'steady.i'
    expect_out = 'This class is experimental'
    requirement = 'The system shall inform the user that ActionComponents of the thermal '
                  'hydraulics module are experimental, without treating the notice as a warning.'
  []
  [jacobian]
    type = 'PetscJacobianTester'
    input = 'jacobian.i'
    ratio_tol = 7e-8
    difference_tol = 15
    cli_args = 'Debug/check_jacobian=true'
    max_threads = 1
    max_parallel = 1
    requirement = 'The system shall have correct Jacobians for a single-phase flow channel '
                  'ActionComponent, including the wall friction kernel and closures materials, '
                  'using the same input as the classic FlowChannel1Phase Component.'
  []

  [physics]
    requirement = 'The system shall simulate a single-phase flow channel ActionComponent, using '
                  'the same inputs and reference results as the classic FlowChannel1Phase '
                  'Component,'

    [phy:f_fn_3eqn]
      type = 'CSVDiff'
      input = 'phy.f_fn.3eqn.i'
      csvdiff = 'phy.f_fn.3eqn_out.csv'
      gold_dir = '../../components/flow_channel_1phase/gold'
      rel_err = 1e-10
      restep = false # Test is prescribed to abort on failed timestep
      detail = 'with a friction factor provided by a function and a connected heat transfer '
               'component with a specified wall temperature, and'
    []
    [phy:sub_discretization]
      type = 'Exodiff'
      input = 'phy.sub_discretization.i'
      exodiff = 'phy.sub_discretization_out.e'
      gold_dir = '../../components/flow_channel_1phase/gold'
      custom_cmp = 'phy.sub_discretization.exodiff'
      # matching geometry at t=0
      recover = false
      detail = 'with multiple length subsections,'
    []
    [steady]
      type = 'Exodiff'
      input = 'steady.i'
      exodiff = 'steady_out.e'
      gold_dir = '../../components/flow_channel_1phase/gold'
      custom_cmp = 'no_P_hf_vel.exodiff'
      detail = 'in a steady problem,'
    []
    [heat_conduction]
      type = 'Exodiff'
      input = 'heat_conduction.i'
      exodiff = 'heat_conduction_out.e'
      gold_dir = '../../components/flow_channel_1phase/gold'
      # The velocity of the closed pipe at rest is round-off noise, about 1e-10
      abs_zero = 1e-8
      detail = 'with heat conduction,'
    []
    [passive_transport]
      type = 'Exodiff'
      input = 'passive_transport.i'
      exodiff = 'passive_transport_out.e'
      gold_dir = '../../components/flow_channel_1phase/gold'
      custom_cmp = 'no_P_hf.exodiff'
      detail = 'with passive transport variables,'
    []
    [phy:par_fn]
      type = 'CSVDiff'
      input = 'phy.par_fn.i'
      csvdiff = 'phy.par_fn_out.csv'
      gold_dir = '../../components/flow_channel_1phase/gold'
      rel_err = 1e-10
      restep = false # Test is prescribed to abort on failed timestep
      detail = 'with a hydraulic diameter provided by a function.'
    []
  []

  [output_vpps]
    type = CSVDiff
    input = 'output_vpps.i'
    csvdiff = 'output_vpps_out_pipe_vars_vpp_0002.csv output_vpps_out_pipe_flux_vpp_0002.csv'
    gold_dir = '../../components/flow_channel_1phase/gold'
    rel_err = 1e-6
    requirement = 'The system shall be able to simulate a single-phase flow channel ActionComponent and output quantities to a CSV file.'
  []

  [err:wrong_fp]
    type = 'RunException'
    input = 'err.wrong_fp.i'
    expect_err = "ActionComponents/pipe/fp: Supplied fluid properties must be for 1-phase fluids."
    requirement = 'The system shall report an error if the fluid properties of a flow channel ActionComponent are not single-phase.'
  []

  [components_convergence]
    type = RunApp
    input = 'components_convergence.i'
    requirement = 'The system shall allow component-wise convergence criteria to be used with flow channel ActionComponents.'
  []
  [err:components_convergence_unsupported]
    type = RunException
    input = 'components_convergence.i'
    cli_args = "ActionComponents/loss/type=FormLossFromFunction1Phase ActionComponents/loss/flow_channel=pipe ActionComponents/loss/K_prime=1"
    expect_err = "The component 'loss' does not provide a nonlinear convergence, which ComponentsConvergence requires of all ActionComponents."
    requirement = 'The system shall report an error if ComponentsConvergence is used with an ActionComponent that does not provide a nonlinear convergence.'
  []
  [err:passive_transport_junction]
    type = RunException
    input = 'err.passive_transport_junction.i'
    expect_err = "This Component type does not support passive transport."
    requirement = 'The system shall report an error if a junction ActionComponent that does not support passive transport connects flow channel ActionComponents with passive transport variables.'
  []
  [err:passive_transport_inlet_size]
    type = RunException
    input = 'err.passive_transport_inlet_size.i'
    expect_err = "The number of entries in 'passives' must match the number of passive transport variables provided in the connected flow channel."
    requirement = 'The system shall report an error if the number of passive transport values of an inlet ActionComponent does not match the number of passive transport variables of the connected flow channel ActionComponent.'
  []
[]
