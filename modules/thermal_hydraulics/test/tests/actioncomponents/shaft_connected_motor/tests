[Tests]
  issues = '#19830 #32558'
  design = 'ShaftConnectedMotorAC.md ShaftAC.md'

  [err:no_initial_speed]
    type = 'RunException'
    input = 'test.i'
    cli_args = 'ActionComponents/hs/initial_T=300'
    expect_err = "ActionComponents/shaft/initial_speed: The `initial_speed` parameter is missing."
    requirement = 'The system shall report an error if the initial speed of a shaft ActionComponent is missing.'
  []
  [err:not_connected_to_shaft]
    type = 'RunException'
    input = 'test.i'
    cli_args = "ActionComponents/hs/initial_T=300 ActionComponents/shaft/initial_speed=0 ActionComponents/shaft/connected_components=''"
    expect_err = "This component must be connected to a shaft"
    requirement = 'The system shall report an error if a shaft-connected ActionComponent is not connected to a shaft.'
  []
  [restart_part1]
    type = 'CSVDiff'
    csvdiff = part1_out.csv
    input = 'test.i'
    gold_dir = '../../components/shaft_connected_motor/gold'
    cli_args = 'ActionComponents/hs/initial_T=300 ActionComponents/shaft/initial_speed=0 Outputs/checkpoint=true Outputs/file_base=part1_out'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to run a shaft ActionComponent connected to a motor ActionComponent, and write a checkpoint.'
  []
  [restart_part2]
    type = 'CSVDiff'
    csvdiff = part2_out.csv
    input = 'test.i'
    gold_dir = '../../components/shaft_connected_motor/gold'
    cli_args = 'Outputs/file_base=part2_out Problem/restart_file_base=part1_out_cp/LATEST Executioner/num_steps=2'
    prereq = 'restart_part1'
    recover = false
    requirement = 'The system shall be able to restart a shaft ActionComponent connected to a motor ActionComponent.'
  []
  [clg]
    type = 'CSVDiff'
    csvdiff = clg.test_out.csv
    input = 'clg.test.i'
    gold_dir = '../../components/shaft_connected_motor/gold'
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to control the torque of a motor ActionComponent connected to a shaft ActionComponent.'
  []
[]
