[Tests]
  issues = '#19830 #32558'
  design = 'HeatSourceFromTotalPowerAC.md'

  [phy:power_component_shape_cylindrical]
    type = 'Exodiff'
    input = 'phy.cylinder_power_shape_fn.i'
    exodiff = 'phy.cylinder_power_shape_fn_out.e'
    gold_dir = '../../components/heat_source_from_total_power/gold'
    rel_err = 1e-4
    abs_zero = 1e-9
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall provide the heat source shape for a cylindrical heat structure ActionComponent when a power component and power shape function are supplied.'
  []
  [phy:power_component_shape_plate]
    type = 'Exodiff'
    input = 'phy.plate.i'
    exodiff = 'phy.plate_out.e'
    gold_dir = '../../components/heat_source_from_total_power/gold'
    rel_err = 1e-4
    abs_zero = 1e-9
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall provide the heat source shape for a plate heat structure ActionComponent when a power component and power shape function are supplied.'
  []
  [phy:conservation_plate]
    type = CSVDiff
    input = 'phy.conservation.i'
    cli_args = "ActionComponents/heat_structure/type=HeatStructurePlate
                ActionComponents/heat_structure/depth=2
                Postprocessors/E_tot/type=ADHeatStructureEnergy
                Postprocessors/E_tot/plate_depth=2
                Outputs/file_base=phy.conservation_plate"
    csvdiff = 'phy.conservation_plate.csv'
    gold_dir = '../../components/heat_source_from_total_power/gold'
    abs_zero = 4e-7
    # because output has execute_on = 'final'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to impose a heat source computed from the power component and shape function onto a plate heat structure ActionComponent and conserve energy.'
  []
  [phy:conservation_cylinder]
    type = CSVDiff
    input = 'phy.conservation.i'
    cli_args = "ActionComponents/heat_structure/type=HeatStructureCylindrical
                ActionComponents/heat_structure/inner_radius=1.0
                Postprocessors/E_tot/type=ADHeatStructureEnergy
                Postprocessors/E_tot/plate_depth=1
                Outputs/file_base=phy.conservation_cylinder"
    csvdiff = 'phy.conservation_cylinder.csv'
    gold_dir = '../../components/heat_source_from_total_power/gold'
    abs_zero = 1e-7
    # because output has execute_on = 'final'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to impose a heat source computed from the power component and shape function onto a cylindrical heat structure ActionComponent and conserve energy.'
  []

  [err:no_hs]
    type = 'RunException'
    input = 'err.base.i'
    cli_args = "ActionComponents/hgen/hs=reactor ActionComponents/hgen/regions='fuel' "
               "ActionComponents/hgen/power=reactor"
    expect_err = "ActionComponents/hgen/hs: The component 'reactor' is not of type 'HeatStructureInterface'"
    requirement = 'The system shall report an error if the heat structure to apply a heat source on, computed from the power component and shape, is not of the expected heat structure interface type for an ActionComponent.'
  []
  [err:wrong_block_name]
    type = 'RunException'
    input = 'err.base.i'
    cli_args = "ActionComponents/hgen/hs=hs ActionComponents/hgen/regions='asdf' "
               "ActionComponents/hgen/power=reactor"
    expect_err = "ActionComponents/hgen/regions: Region 'asdf' does not exist in heat structure 'hs'."
    requirement = 'The system shall report an error if the specified region to apply a heat source on, computed from the power component and shape, does not exist for an ActionComponent.'
  []
  [err:wrong_power_comp]
    type = 'RunException'
    input = 'err.base.i'
    cli_args = "ActionComponents/hgen/hs=hs ActionComponents/hgen/regions='fuel' "
               "ActionComponents/hgen/power=hs"
    expect_err = "ActionComponents/hgen/power: The component 'hs' is not of type 'TotalPowerBase'"
    requirement = 'The system shall report an error if the power component used to compute a heat source is not of the expected type for an ActionComponent.'
  []

  [phy:conservation_from_file_3d]
    type = CSVDiff
    input = 'phy.conservation_from_file_3d.i'
    csvdiff = 'phy.conservation_from_file_3d_out.csv'
    gold_dir = '../../components/heat_source_from_total_power/gold'
    abs_zero = 1e-7
    # because output has execute_on = 'final'
    recover = false
    restep = false # Test is prescribed to abort on failed timestep
    requirement = 'The system shall be able to apply a heat source, computed from the power component and shape, onto a heat structure ActionComponent whose mesh is loaded from a mesh file.'
  []
[]
